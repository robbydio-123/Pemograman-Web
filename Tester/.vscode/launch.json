{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "jdk",
            "request": "launch",
            "name": "Launch Java App"
        },
        {
            "name": "Attach to Shared Memory",
            "type": "jdk",
            "request": "attach",
            "sharedMemoryName": ""
        },
        {
            "name": "Attach to Process",
            "type": "jdk",
            "request": "attach",
            "processId": "${command:jdk.java.attachDebugger.pickProcess}"
        },
        {
            "name": "Attach to Port",
            "type": "jdk",
            "request": "attach",
            "hostName": "localhost",
            "port": "8000"
        },
        {
            "name": "Attach by com.sun.jdi.SharedMemoryListen",
            "type": "jdk",
            "request": "attach",
            "listen": "true"
        },
        {
            "name": "Launch Integrated Browser",
            "request": "launch",
            "type": "editor-browser",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Integrated Browser",
            "request": "attach",
            "type": "editor-browser",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Edge",
            "port": 9222,
            "request": "attach",
            "type": "msedge",
            "webRoot": "${workspaceFolder}"
        },



        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },


        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Open index.html",
            "file": "c:\\Ambon Semester 3\\Pemograman Web\\JS 4\\docs\\index.html"
        }
    ]
}